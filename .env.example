# GhostBus environment. Copy to .env and fill what you have.
# The app runs with NONE of these set (in-memory store + honest Demo Mode),
# but a real Postgres unlocks persistent Honest-ETA history.

# Postgres connection string (Neon / Render free tier). Optional.
DATABASE_URL=

# Vancouver (TransLink) GTFS-realtime needs a free developer key.
# Register at developer.translink.ca. Never commit the real value.
TRANSLINK_API_KEY=

# Server port (defaults to 8799).
PORT=8799
