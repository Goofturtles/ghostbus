# GhostBus environment. Copy to .env and fill what you have.
# With DATABASE_URL unset the app uses an embedded Postgres (PGlite) under .data/,
# so it runs with zero signup; set DATABASE_URL to use a real Postgres (Neon/Render).

# Postgres connection string (Neon / Render free tier). Optional — see above.
DATABASE_URL=

# API server port (defaults to 8799).
PORT=8799
